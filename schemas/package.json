{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hercules.dev/schemas/package.json",
  "title": "Hercules package",
  "description": "A versioned, trusted bundle of DuckDB extensions, macros, sources, and Prometheus metric definitions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "hercules.dev/v1alpha1"
    },
    "kind": {
      "const": "Package"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "minHerculesVersion": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].*)?$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "macros": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/macro"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    }
  },
  "required": ["apiVersion", "kind", "name", "version"],
  "$defs": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        }
      },
      "required": ["name"]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          }
        },
        "community": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          }
        }
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "description": "DuckDB macro declaration body, for example one() AS (SELECT 1);"
        }
      },
      "required": ["name", "sql"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"refreshIntervalSeconds": {"type": "integer", "minimum": 1}},
            "required": ["refreshIntervalSeconds"]
          },
          "then": {
            "properties": {"materialize": {"const": true}},
            "required": ["materialize"]
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "type": {
          "enum": ["sql", "parquet", "json", "csv"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "materialize": {
          "type": "boolean",
          "default": false
        },
        "refreshIntervalSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800,
          "default": 0,
          "description": "Only materialized sources may refresh. Zero disables refresh."
        }
      },
      "required": ["name", "type", "source"]
    },
    "metricBaseProperties": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "help": {
          "type": "string",
          "minLength": 1
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "uniqueItems": true
        }
      },
      "required": ["name", "help", "sql"]
    },
    "simpleMetric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"},
        "enabled": {"type": "boolean", "default": true},
        "help": {"type": "string", "minLength": 1},
        "sql": {"type": "string", "minLength": 1},
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
          "uniqueItems": true
        }
      },
      "required": ["name", "help", "sql"]
    },
    "histogramMetric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"},
        "enabled": {"type": "boolean", "default": true},
        "help": {"type": "string", "minLength": 1},
        "sql": {"type": "string", "minLength": 1},
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
          "uniqueItems": true
        },
        "histogramMode": {"const": "observations", "default": "observations"},
        "buckets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "number"}
        }
      },
      "required": ["name", "help", "sql", "buckets"]
    },
    "objective": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "error": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
          },
          "required": ["quantile", "error"]
        },
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "deprecated": true,
          "description": "Legacy shorthand; use a quantile/error object."
        }
      ]
    },
    "summaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"},
        "enabled": {"type": "boolean", "default": true},
        "help": {"type": "string", "minLength": 1},
        "sql": {"type": "string", "minLength": 1},
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
          "uniqueItems": true
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/objective"}
        }
      },
      "required": ["name", "help", "sql", "objectives"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gauge": {"type": "array", "items": {"$ref": "#/$defs/simpleMetric"}},
        "counter": {"type": "array", "items": {"$ref": "#/$defs/counterMetric"}},
        "histogram": {"type": "array", "items": {"$ref": "#/$defs/histogramMetric"}},
        "summary": {"type": "array", "items": {"$ref": "#/$defs/summaryMetric"}}
      }
    },
    "counterMetric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*_total$"},
        "enabled": {"type": "boolean", "default": true},
        "help": {"type": "string", "minLength": 1},
        "sql": {"type": "string", "minLength": 1},
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
          "uniqueItems": true
        }
      },
      "required": ["name", "help", "sql"]
    }
  }
}
